# ---- Sourcing: Serper.dev (Google Search results API, free tier available) ----
SERPER_API_KEY=

# ---- Planning, scoring and resume OCR: OpenRouter ----
OPENROUTER_API_KEY=
# Cheap, fast, vision-capable. Override if OpenRouter renames or you prefer another.
OPENROUTER_TEXT_MODEL=google/gemini-2.5-flash
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
OPENROUTER_SCORING_MODEL=google/gemini-2.5-flash

# ---- Scoring backend ----
# "openrouter" (default) scores on your OpenRouter credits and needs no TypeSafe key.
# "typesafe" calls Jev's System One endpoint for genuinely calibrated probabilities.
# Jev is NOT available through OpenRouter — it is served only from TypeSafe's API.
SCORING_PROVIDER=openrouter
# Candidates judged per request. Higher = fewer calls, lower cost, longer prompt.
SCORING_BATCH_SIZE=10

# Only needed when SCORING_PROVIDER=typesafe
TYPESAFE_API_KEY=

# ---- App ----
# Sign sessions with this. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
PUBLIC_BASE_URL=http://localhost:8000
# Postgres connection string (Neon). When set it is used instead of SQLite.
# Neon gives you one like: postgresql://USER:PASS@ep-xxx.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Local SQLite fallback, used only when DATABASE_URL is empty
DB_PATH=data/app.db
MAX_UPLOAD_BYTES=8388608

# ---- Plans ----
# Always-Pro accounts (comma separated), e.g. your own login. Survives DB resets.
COMP_ACCOUNTS=

FREE_RUNS_PER_MONTH=3
PRO_RUNS_PER_MONTH=250
PRO_PRICE_LABEL=$5/mo

# ---- Billing: Stripe (leave blank to run without billing) ----
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# ---- Optional base-URL overrides (for testing against stubs) ----
# SERPER_BASE_URL=https://google.serper.dev
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
